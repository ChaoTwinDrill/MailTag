{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MailTag",
  "version": "0.2.5",
  "identifier": "com.usuario.mailtag",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MailTag",
        "width": 1200,
        "height": 850
      }
    ],
    "security": {
      "csp": null,
       "assetProtocol": {
        "enable": true,
        "scope": [ "$APPDATA/**"
    ]
       }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCNzlGMUE0MUU4OEUwRkYKUldULzRJZ2VwUEY1cTU1bE1oUTJwcnNWWS9qQWVvM01TS1Nkd01VVVdiazErMnVEaW9FbEFUUm4K",
      "endpoints": [
        "https://github.com/ChaoTwinDrill/MailTag/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
